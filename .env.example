# Copy this file to .env and adjust values
SECRET_KEY=django-insecure-change-me-in-production-!@#$%^&*()
DEBUG=True
ALLOWED_HOSTS=*

# Database — use 'db' for Docker, 'localhost' for local dev
DB_NAME=facturacion
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery — use 'redis' for Docker, 'localhost' for local dev
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS
CORS_ALLOW_ALL=True

# Supabase (for Vercel deployment)
SUPABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vercel
API_BASE_URL=https://facturacion-api.vercel.app/api/v1
